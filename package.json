{
  "name": "sirius",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sirius/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "pnpm --filter @sirius/api db:migrate",
    "infra:up": "docker compose up -d --build --wait",
    "infra:logs": "docker logs -f sirius-api",
    "infra:down": "docker compose down"
  }
}
